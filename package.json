{
  "version": "2.0.0",
  "license": "MIT",
  "repository": "github:miguel-silva/react-marksome",
  "description": "Lightweight, flexible and readable labels in React using a subset of markdown",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsdown --watch",
    "build": "tsdown",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "format": "prettier . --write",
    "prepare": "npm run build",
    "size": "size-limit",
    "storybook": "storybook dev -p 6006"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run type-check && npm run test"
    }
  },
  "browserslist": ">0.25% or last 2 major versions and supports es6-module",
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all"
  },
  "name": "react-marksome",
  "author": "Miguel Silva",
  "size-limit": [
    {
      "path": "dist/index.cjs",
      "limit": "1.7 KB"
    },
    {
      "path": "dist/index.js",
      "limit": "1.5 KB"
    }
  ],
  "devDependencies": {
    "@emotion/css": "^11.1.3",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@storybook/addon-essentials": "^8.5.0",
    "@storybook/addon-links": "^8.5.0",
    "@storybook/react": "^8.5.0",
    "@storybook/react-vite": "^8.5.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^11.2.3",
    "@types/node": "^24.7.2",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "happy-dom": "^20.0.0",
    "husky": "^4.3.8",
    "prettier": "^2.8.1",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "react-icons": "^5.5.0",
    "size-limit": "^11.2.0",
    "storybook": "^8.5.0",
    "tsdown": "^0.15.4",
    "tslib": "^2.1.0",
    "typescript": "^5.9.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.4"
  }
}
